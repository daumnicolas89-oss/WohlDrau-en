# Optional. Ohne diese Werte laufen Community-Meldungen im Arbeitsspeicher
# des Servers und überleben keinen Neustart.
NEXT_PUBLIC_SUPABASE_URL=
# Serverseitig, umgeht Row Level Security. Niemals ins Frontend geben.
SUPABASE_SERVICE_ROLE_KEY=
# Alternative, wenn kein Service-Role-Key verwendet werden soll:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
